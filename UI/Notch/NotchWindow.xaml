<Window x:Class="SkyBar.UI.Notch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="clr-namespace:SkyBar.UI.DesignSystem"
        Title="Sky Bar"
        Width="730" Height="326"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        RenderOptions.BitmapScalingMode="HighQuality"
        FontFamily="{StaticResource MacPrimaryFont}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Palet Teks & Permukaan Ultra-Clean -->
        <SolidColorBrush x:Key="CleanPrimaryText" Color="#FFF8FAFC"/>
        <SolidColorBrush x:Key="CleanSecondaryText" Color="#FFA6B0C3"/>
        <SolidColorBrush x:Key="CleanMutedText" Color="#FF727C90"/>
        <SolidColorBrush x:Key="CleanCardBg" Color="#FF11131A"/>
        <SolidColorBrush x:Key="CleanCardBorder" Color="#1EFFFFFF"/>

        <!-- Tombol tab bulat di bar kiri atas Notch (dengan indikator pill yang bisa digeser kursor) -->
        <Style x:Key="NotchTopTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFA6B0C3"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="13" Background="Transparent"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFF8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kartu Bento gelap halus dengan border tipis -->
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CleanCardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CleanCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <!-- Tombol aksi cepat bawah -->
        <Style x:Key="QuickToolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource CleanCardBg}"
                                BorderBrush="{StaticResource CleanCardBorder}" BorderThickness="1" CornerRadius="12"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1B1F2B"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#36FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF242938"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Musik Interaktif -->
        <Style x:Key="MusicSeekFillRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2,0,0,2" Background="{DynamicResource MacAccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicSeekEmptyRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="0,2,2,0" Background="#FF272B38"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicSeekThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False" SnapsToDevicePixels="False">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#FFFFFFFF" Stroke="{DynamicResource MacAccentBrush}" StrokeThickness="2">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.22" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.22" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MusicSeekSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="16" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MusicSeekFillRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MusicSeekEmptyRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MusicSeekThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item dan ComboBox Bar Pilihan Output Audio langsung di dalam Notch -->
        <Style x:Key="AudioBarComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,7" Margin="2,1" Background="Transparent"
                                TextElement.Foreground="#FFF8FAFC">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark" Grid.Column="0" Text="&#xE73E;"
                                           FontFamily="{StaticResource MacIconFont}" FontSize="10.5"
                                           Foreground="{DynamicResource MacAccentBrush}"
                                           VerticalAlignment="Center" Opacity="0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  TextElement.Foreground="#FFF8FAFC"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioBarComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFF8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AudioBarComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                                          Foreground="#FFF8FAFC"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource CleanCardBg}"
                                                BorderBrush="{StaticResource CleanCardBorder}"
                                                BorderThickness="1" CornerRadius="12" Padding="11,0" Height="34"
                                                TextElement.Foreground="#FFF8FAFC">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE7F6;" Style="{StaticResource IconGlyph}"
                                                           FontSize="12.5" Foreground="#FF64D2FF" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontFamily="{StaticResource MacPrimaryFont}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource CleanPrimaryText}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource MacIconFont}"
                                                           FontSize="9.5" Foreground="{StaticResource CleanSecondaryText}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FF1A1E2A"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxWidth="320" MaxHeight="210" Margin="0,4,0,0">
                                    <Border Background="#FF161924" BorderBrush="#2EFFFFFF" BorderThickness="1" CornerRadius="11" Padding="4"
                                            TextElement.Foreground="#FFF8FAFC">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.55"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="ScaleRoot" HorizontalAlignment="Center" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="NotchScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid x:Name="NotchRoot"
              Width="650" Height="276"
              AllowDrop="True"
              MouseEnter="NotchRoot_MouseEnter"
              MouseLeave="NotchRoot_MouseLeave"
              PreviewDragEnter="NotchRoot_PreviewDragEnter"
              PreviewDragOver="NotchRoot_PreviewDragOver"
              DragLeave="NotchRoot_DragLeave"
              Drop="FileShelfDropZone_Drop">

            <Path x:Name="NotchShape"
                  Fill="#FF06070A"
                  Stroke="#00FFFFFF"
                  StrokeThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Path.Effect>
                    <DropShadowEffect x:Name="NotchShadow" BlurRadius="32" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0"/>
                </Path.Effect>
            </Path>

            <Grid x:Name="ContentHost">

                <!-- ======================================================== -->
                <!--  STATE 1: COLLAPSED (Notch / Pill / Bar tertutup)        -->
                <!-- ======================================================== -->
                <Grid x:Name="CollapsedContentGrid"
                      Width="176" Height="32"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" x:Name="CollapsedLeftContainer" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid x:Name="AutoLeftGraphic" Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="IdleDot" Width="6" Height="6" Fill="{DynamicResource MacAccentBrush}"/>
                            <Border x:Name="MiniCoverHost" Width="20" Height="20" CornerRadius="5" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="MiniCoverBrush" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ds:MacWeatherIcon x:Name="CollapsedWeatherIcon" Width="16" Height="16"
                                           Margin="0,0,5,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CollapsedLeftIcon" Text="&#xE916;" Style="{StaticResource IconGlyph}" FontSize="11.5"
                                   Foreground="{DynamicResource MacAccentBrush}" Margin="2,0,5,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="CollapsedLeftText" Text="" Style="{StaticResource NotchBodyText}" FontSize="11.5"
                                   Foreground="{StaticResource CleanPrimaryText}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" MaxWidth="120" Margin="3,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Titik notifikasi belum dibaca (dinamis) -->
                        <Grid x:Name="CollapsedUnreadBadge" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="Collapsed">
                            <Border CornerRadius="7" Height="14" MinWidth="14" Padding="4,0" Background="#FFFF453A">
                                <TextBlock x:Name="CollapsedUnreadText" Text="1" FontSize="9" FontWeight="Bold"
                                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="MiniClockText" Text="21:40"
                                   Style="{StaticResource NotchBodyText}" Foreground="{StaticResource CleanPrimaryText}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <StackPanel x:Name="EqualizerPanel" Orientation="Horizontal"
                                    Height="14" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <Rectangle x:Name="EqBar0" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource MacAccentBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EqBar1" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource MacAccentBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EqBar2" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource MacAccentBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                            <Rectangle x:Name="EqBar3" Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Margin="1,0" Fill="{DynamicResource MacAccentBrush}" RenderTransformOrigin="0.5,0.5"><Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform></Rectangle>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ======================================================== -->
                <!--  STATE 2: EXPANDED (Smart Bento Control Center)          -->
                <!-- ======================================================== -->
                <Grid x:Name="ExpandedContentGrid"
                      Width="558" Height="228"
                      Margin="0,12,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ExpandedScale" ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform x:Name="ExpandedShift" Y="-10"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ==================================================== -->
                    <!--  BARIS ATAS: Navigasi Tab Kiri & Cuaca/Baterai Kanan -->
                    <!-- ==================================================== -->
                    <Grid Grid.Row="0">
                        <!-- Pill Navigasi Mode di Kiri (Bisa diklik, di-scroll, atau digeser/slide langsung dengan kursor) -->
                        <Border x:Name="TopNavBarBorder"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="#FF11131A" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="16" Padding="3,2" Cursor="Hand"
                                ToolTip="Klik atau tahan &amp; geser kursor untuk berpindah menu"
                                PreviewMouseLeftButtonDown="TopNavBar_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="TopNavBar_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="TopNavBar_PreviewMouseLeftButtonUp"
                                PreviewMouseWheel="TopNavBar_PreviewMouseWheel">
                            <Grid>
                                <!-- Indikator Pill Aktif yang Meluncur Halus Mengikuti Kursor -->
                                <Border x:Name="TopNavSlidingPill"
                                        Width="30" Height="26" CornerRadius="13"
                                        Background="#FF2B3142" BorderBrush="#2CFFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="1,0,0,0" IsHitTestVisible="False"
                                        UseLayoutRounding="False" SnapsToDevicePixels="False"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="TopNavPillScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="TopNavPillShift" X="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>

                                <StackPanel x:Name="TopNavTabsPanel" Orientation="Horizontal">
                                    <RadioButton x:Name="TabHubRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 IsChecked="True" ToolTip="Dashboard Utama"
                                                 Checked="TopNavTab_Checked">
                                        <TextBlock Text="&#xE74C;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                    </RadioButton>

                                    <RadioButton x:Name="TabMusicLyricsRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="Slide Musik &amp; Lirik Tersinkronisasi"
                                                 Checked="TopNavTab_Checked">
                                        <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                    </RadioButton>

                                    <RadioButton x:Name="TabWeatherRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="Cuaca macOS &amp; Lokasi Laptop"
                                                 Checked="TopNavTab_Checked">
                                        <ds:MacWeatherIcon x:Name="NavBarWeatherIcon" Width="17" Height="17" IconKind="PartlyCloudy"/>
                                    </RadioButton>

                                    <RadioButton x:Name="TabShelfRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="File Drop (Drag &amp; Drop File)"
                                                 Checked="TopNavTab_Checked">
                                        <Grid>
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                            <Ellipse x:Name="ShelfHasItemsDot" Width="5" Height="5" Fill="{DynamicResource MacAccentBrush}"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-3,0" Visibility="Collapsed"/>
                                        </Grid>
                                    </RadioButton>

                                    <RadioButton x:Name="TabClipboardRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="Clipboard Auto-Paste"
                                                 Checked="TopNavTab_Checked">
                                        <TextBlock Text="&#xE77F;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                    </RadioButton>

                                    <RadioButton x:Name="TabPomodoroRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="Focus / Pomodoro Timer"
                                                 Checked="TopNavTab_Checked">
                                        <TextBlock Text="&#xE916;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                    </RadioButton>

                                    <RadioButton x:Name="TabNotificationsRadio" Style="{StaticResource NotchTopTabRadio}"
                                                 ToolTip="Pusat Notifikasi"
                                                 Checked="TopNavTab_Checked">
                                        <Grid>
                                            <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}" FontSize="12.5"/>
                                            <Border x:Name="NavUnreadBadge" CornerRadius="6" Height="11" MinWidth="11" Padding="3,0"
                                                    Background="#FFFF453A" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-5,-8,0" Visibility="Collapsed" IsHitTestVisible="False">
                                                <TextBlock x:Name="NavUnreadText" Text="1" FontSize="7.5" FontWeight="Bold"
                                                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Status Cuaca 3D, Baterai, Pin, Settings & Close di Kanan -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                            <TextBlock x:Name="ExpandedDateText" Text="Sen, 2 Nov"
                                       Style="{StaticResource NotchCaptionText}" FontSize="11.5"
                                       Foreground="{StaticResource CleanSecondaryText}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                            <!-- Badge Cuaca dengan Ikon 3D macOS Weather -->
                            <Border Style="{StaticResource NotchHoverRow}" Background="#14FFFFFF" CornerRadius="10" Padding="8,3" Margin="0,0,7,0"
                                    ToolTip="Klik untuk melihat prakiraan cuaca lengkap" MouseLeftButtonUp="WeatherBadge_MouseLeftButtonUp">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ds:MacWeatherIcon x:Name="TopWeatherIconControl" Width="17" Height="17"
                                                       IconKind="PartlyCloudy" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="TopWeatherTempText" Text="30°C" Style="{StaticResource NotchBodyText}"
                                               Foreground="{StaticResource CleanPrimaryText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Persentase Baterai + Indikator Lingkaran Hijau -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="BatteryText" Text="100%" Style="{StaticResource NotchBodyText}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CleanPrimaryText}"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse Stroke="#FF30D158" StrokeThickness="2" Fill="#1F30D158"/>
                                    <TextBlock x:Name="BatteryGlyph" Text="&#xE945;" Style="{StaticResource IconGlyph}"
                                               FontSize="9.5" Foreground="#FF30D158"/>
                                </Grid>
                            </StackPanel>

                            <!-- Pin Notch -->
                            <Button x:Name="PinNotchButton" Style="{StaticResource NotchIconButton}" Width="26" Height="26"
                                    ToolTip="Sematkan Notch (tetap terbuka)" Click="PinNotch_Click">
                                <TextBlock x:Name="PinNotchGlyph" Text="&#xE718;" Style="{StaticResource IconGlyph}"
                                           FontSize="11.5" Foreground="{StaticResource CleanSecondaryText}"/>
                            </Button>

                            <!-- Buka Pengaturan -->
                            <Button Style="{StaticResource NotchIconButton}" Width="26" Height="26" Margin="2,0"
                                    ToolTip="Pengaturan Sky Bar" Click="OpenSettings_Click">
                                <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}"
                                           FontSize="12" Foreground="{StaticResource CleanSecondaryText}"/>
                            </Button>

                            <!-- Tutup / Collapse Notch -->
                            <Button Style="{StaticResource NotchIconButton}" Width="26" Height="26"
                                    ToolTip="Tutup Notch" Click="ForceCollapse_Click">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}"
                                           FontSize="10.5" Foreground="{StaticResource CleanSecondaryText}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ==================================================== -->
                    <!--  AREA KONTEN UTAMA (Transisi Slide Halus Antar Tab)  -->
                    <!-- ==================================================== -->
                    <Grid Grid.Row="2" x:Name="TabContentStageGrid"
                          UseLayoutRounding="False" SnapsToDevicePixels="False"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TabContentScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="TabContentShift" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- ================================================ -->
                        <!--  VIEW 1: BENTO HUB (Media + Slider + Live Lyric  -->
                        <!--          + Audio Selector + macOS Weather Card)  -->
                        <!-- ================================================ -->
                        <Grid x:Name="HubViewGrid" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="236"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- KOLOM KIRI: Kartu Pemutar Media + Slide Musik + Lirik Live -->
                            <Border Grid.Column="0" Style="{StaticResource BentoCard}" Padding="13,11,13,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Sampul Album + Judul + Artis -->
                                    <Grid Grid.Row="0" Cursor="Hand" MouseLeftButtonUp="OpenLyricsSlide_MouseLeftButtonUp"
                                          ToolTip="Klik untuk membuka panggung Lirik Tersinkronisasi">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="48" Height="48">
                                            <Border CornerRadius="11" Background="#FF1C202C" BorderBrush="#22FFFFFF" BorderThickness="1">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="19"
                                                           Foreground="{StaticResource CleanSecondaryText}"/>
                                            </Border>
                                            <Image x:Name="CoverArtImage" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="11" RadiusY="11"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="TrackTitleText" Text="Not playing"
                                                       Style="{StaticResource NotchTitleText}" Foreground="{StaticResource CleanPrimaryText}" FontSize="13.5"/>
                                            <TextBlock x:Name="TrackArtistText" Text="Play something to see it here"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="11.5"
                                                       Foreground="{StaticResource CleanSecondaryText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Baris Lirik Live Tersinkronisasi -->
                                    <Border Grid.Row="1" Background="#16FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                            CornerRadius="8" Padding="8,4" Margin="0,7,0,2"
                                            Cursor="Hand" MouseLeftButtonUp="OpenLyricsSlide_MouseLeftButtonUp"
                                            ToolTip="Lirik tersinkronisasi • Klik untuk tampilan penuh">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="♪" FontSize="11" FontWeight="Bold"
                                                       Foreground="#FF64D2FF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" x:Name="HubLiveLyricText"
                                                       Text="Putar lagu untuk sinkronisasi lirik"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="11"
                                                       FontWeight="SemiBold" Foreground="#FFF1F5F9" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Slider Musik Interaktif -->
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,2,0,2">
                                        <Slider x:Name="MediaSeekSlider"
                                                Minimum="0" Maximum="100" Value="0"
                                                Style="{StaticResource MusicSeekSlider}"
                                                PreviewMouseLeftButtonDown="MediaSeekSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="MediaSeekSlider_PreviewMouseLeftButtonUp"
                                                ValueChanged="MediaSeekSlider_ValueChanged"/>
                                        <Grid Margin="1,-2,1,0">
                                            <TextBlock x:Name="MediaElapsedText" Text="0:00"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                       Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="MediaDurationText" Text="--:--"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                       Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Tombol Kontrol Media -->
                                    <Grid Grid.Row="3" VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource NotchIconButton}" Width="30" Height="30"
                                                    Click="PrevTrack_Click" ToolTip="Sebelumnya">
                                                <TextBlock Text="&#xE892;" Style="{StaticResource IconGlyph}" FontSize="11.5" Foreground="{StaticResource CleanPrimaryText}"/>
                                            </Button>

                                            <Button Width="34" Height="34" Margin="12,0" Cursor="Hand"
                                                    Click="PlayPause_Click" ToolTip="Putar / Jeda" FocusVisualStyle="{x:Null}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="PlayCircle" Width="34" Height="34" CornerRadius="17" Background="#FFF8FAFC">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35"/>
                                                            </Border.Effect>
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="PlayCircle" Property="Background" Value="#FFFFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock x:Name="PlayPauseGlyph" Text="&#xE768;" Style="{StaticResource IconGlyph}"
                                                           FontSize="14" Foreground="#FF090A0F" Margin="1,0,0,0"/>
                                            </Button>

                                            <Button Style="{StaticResource NotchIconButton}" Width="30" Height="30"
                                                    Click="NextTrack_Click" ToolTip="Berikutnya">
                                                <TextBlock Text="&#xE893;" Style="{StaticResource IconGlyph}" FontSize="11.5" Foreground="{StaticResource CleanPrimaryText}"/>
                                            </Button>
                                        </StackPanel>

                                        <Button Style="{StaticResource NotchIconButton}" Width="26" Height="26"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="OpenLyricsSlideButton_Click" ToolTip="Buka Slide Musik &amp; Lirik Penuh">
                                            <TextBlock Text="&#xE90B;" Style="{StaticResource IconGlyph}" FontSize="11.5" Foreground="{StaticResource CleanSecondaryText}"/>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- KOLOM KANAN: Pilihan Output Audio + Kartu Cuaca macOS + Network + Quick Tools -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="33"/>
                                    <RowDefinition Height="7"/>
                                    <RowDefinition Height="35"/>
                                </Grid.RowDefinitions>

                                <!-- Row 1: Bar Pilihan Output Audio Interaktif + Pomodoro Chip -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" x:Name="AudioOutputComboBox"
                                              Style="{StaticResource AudioBarComboBox}"
                                              ToolTip="Klik untuk memilih perangkat output audio"
                                              DropDownOpened="AudioOutputComboBox_DropDownOpened"
                                              SelectionChanged="AudioOutputComboBox_SelectionChanged"/>

                                    <Button Grid.Column="2" x:Name="PomodoroButton" Style="{StaticResource QuickToolButton}"
                                            Padding="10,0" ToolTip="Klik: Mulai/Jeda Fokus • Klik kanan: Reset"
                                            Click="PomodoroButton_Click" MouseRightButtonUp="PomodoroButton_RightClick">
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <TextBlock Text="&#xE916;" Style="{StaticResource IconGlyph}" FontSize="11.5"
                                                       Foreground="#FF64D2FF" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="PomodoroText" Text="25:00" Style="{StaticResource NotchBodyText}"
                                                       Foreground="{StaticResource CleanPrimaryText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Row 2: Kartu Cuaca macOS dengan Ikon 3D Squircle (klik langsung menuju website cuaca) -->
                                <Border Grid.Row="2" CornerRadius="13" Padding="11,7" Cursor="Hand"
                                        BorderBrush="#28FFFFFF" BorderThickness="1"
                                        MouseLeftButtonUp="OpenWeatherWebsite_MouseLeftButtonUp"
                                        ToolTip="Klik untuk membuka prakiraan cuaca lengkap di website">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="HubWeatherGradStart" Color="#FF192B48" Offset="0"/>
                                            <GradientStop x:Name="HubWeatherGradEnd" Color="#FF111622" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Ikon 3D Squircle Biru Apple Weather -->
                                        <ds:MacWeatherIcon Grid.Column="0" x:Name="HubWeatherIconControl"
                                                           Width="40" Height="40"
                                                           ShowSquircleBadge="True"
                                                           IconKind="PartlyCloudy"
                                                           VerticalAlignment="Center"/>

                                        <!-- Suhu & H/L -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="HubWeatherTempText" Text="30°"
                                                       FontFamily="{StaticResource MacDisplayFont}" FontSize="20" FontWeight="Bold"
                                                       Foreground="#FFF8FAFC" LineHeight="20"/>
                                            <TextBlock x:Name="HubWeatherHighLowText" Text="H:32° L:24°"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#FFB8C8E0"/>
                                        </StackPanel>

                                        <!-- Lokasi, Kondisi & Kesimpulan + Indikator Website ↗ -->
                                        <Grid Grid.Column="4" VerticalAlignment="Center">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="HubWeatherLocText" Text="Lokasi Laptop"
                                                               Style="{StaticResource NotchBodyText}" FontSize="11.5"
                                                               FontWeight="Bold" Foreground="#FFF8FAFC"/>
                                                    <TextBlock Text=" • " Foreground="#FF8EA4C4" FontSize="11"/>
                                                    <TextBlock x:Name="HubWeatherCondText" Text="Partly Cloudy"
                                                               Style="{StaticResource NotchCaptionText}" FontSize="11"
                                                               FontWeight="Medium" Foreground="#FF98C6FF"/>
                                                </StackPanel>
                                                <TextBlock x:Name="HubWeatherSummaryText"
                                                           Text="Awan tipis menaungi langit siang ini, sejuk dan nyaman."
                                                           Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                                           Foreground="#FFDCE6F5" TextWrapping="Wrap" MaxHeight="26"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,14,0"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="9.5"
                                                       Foreground="#FF98C6FF" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                       Margin="0,1,0,0" Opacity="0.85"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Row 3: Network Speed Card -->
                                <Border Grid.Row="4" Style="{StaticResource BentoCard}" CornerRadius="12" Padding="12,0">
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="Network" Style="{StaticResource NotchBodyText}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CleanSecondaryText}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="↓ " Foreground="#FF64D2FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NetDownText" Text="0.0 KB/s" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource CleanPrimaryText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <TextBlock Text="↑ " Foreground="#FF30D158" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="NetUpText" Text="0.0 KB/s" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource CleanPrimaryText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Row 4: Quick Action Pills + File Drop Trigger -->
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="7"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource QuickToolButton}"
                                            Click="QuickCalc_Click" ToolTip="Buka Kalkulator">
                                        <TextBlock Text="&#xE8EF;" Style="{StaticResource IconGlyph}" FontSize="13.5"/>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource QuickToolButton}"
                                            Click="QuickSnip_Click" ToolTip="Screenshot / Snipping Tool">
                                        <TextBlock Text="&#xE8A6;" Style="{StaticResource IconGlyph}" FontSize="13.5"/>
                                    </Button>

                                    <Button Grid.Column="4" Style="{StaticResource QuickToolButton}"
                                            Click="OpenLyricsSlideButton_Click" ToolTip="Slide Musik &amp; Lirik">
                                        <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="13.5"/>
                                    </Button>

                                    <Button Grid.Column="6" Style="{StaticResource QuickToolButton}"
                                            Click="QuickOpenShelf_Click" ToolTip="Drop File (Drag &amp; Drop)">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="12.5"
                                                       Foreground="#FF64D2FF" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="QuickShelfLabelText" Text="Drop File"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="11.5"
                                                       FontWeight="SemiBold" Foreground="{StaticResource CleanPrimaryText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>

                        <!-- ================================================ -->
                        <!--  VIEW 2: SLIDE MUSIK & LIRIK TERSINKRONISASI     -->
                        <!-- ================================================ -->
                        <Border x:Name="MusicLyricsViewGrid" CornerRadius="14" Padding="15,12"
                                BorderBrush="#24FFFFFF" BorderThickness="1" Visibility="Collapsed">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF161926" Offset="0"/>
                                    <GradientStop Color="#FF0C0E14" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="212"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Background="#240A84FF" CornerRadius="7" Padding="8,2.5">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="5" Height="5" Fill="#FF64D2FF"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="LyricsSourceBadgeText" Text="Synced • Media Player"
                                                           Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                           FontWeight="SemiBold" Foreground="#FF94D2FF"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="46" Height="46">
                                            <Border CornerRadius="10" Background="#FF1F2330">
                                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconGlyph}" FontSize="18" Foreground="{StaticResource CleanSecondaryText}"/>
                                            </Border>
                                            <Image x:Name="LyricsCoverArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,46,46" RadiusX="10" RadiusY="10"/>
                                                </Image.Clip>
                                            </Image>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="LyricsTrackTitleText" Text="Not playing"
                                                       Style="{StaticResource NotchTitleText}" Foreground="{StaticResource CleanPrimaryText}" FontSize="12.5"/>
                                            <TextBlock x:Name="LyricsTrackArtistText" Text="Play music to sync lyrics"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="11" Foreground="{StaticResource CleanSecondaryText}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,6,0,2">
                                        <Slider x:Name="LyricsViewSeekSlider"
                                                Minimum="0" Maximum="100" Value="0"
                                                Style="{StaticResource MusicSeekSlider}"
                                                PreviewMouseLeftButtonDown="MediaSeekSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseLeftButtonUp="MediaSeekSlider_PreviewMouseLeftButtonUp"
                                                ValueChanged="LyricsViewSeekSlider_ValueChanged"/>
                                        <Grid Margin="1,-2,1,0">
                                            <TextBlock x:Name="LyricsElapsedText" Text="0:00"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10" Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="LyricsDurationText" Text="--:--"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10" Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" Click="PrevTrack_Click">
                                            <TextBlock Text="&#xE892;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{StaticResource CleanPrimaryText}"/>
                                        </Button>
                                        <Button Style="{StaticResource NotchIconButton}" Width="32" Height="32" Margin="10,0" Click="PlayPause_Click">
                                            <TextBlock x:Name="LyricsPlayPauseGlyph" Text="&#xE768;" Style="{StaticResource IconGlyph}" FontSize="14" Foreground="#FFFFFFFF"/>
                                        </Button>
                                        <Button Style="{StaticResource NotchIconButton}" Width="28" Height="28" Click="NextTrack_Click">
                                            <TextBlock Text="&#xE893;" Style="{StaticResource IconGlyph}" FontSize="11" Foreground="{StaticResource CleanPrimaryText}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Kanan: Panggung Lirik Tersinkronisasi -->
                                <Border Grid.Column="2" Background="#16FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        CornerRadius="12" Padding="16,10" ClipToBounds="True">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" x:Name="LyricPrevLineText" Text=""
                                                   Style="{StaticResource NotchBodyText}" FontSize="11.5"
                                                   Foreground="#FF747E94" TextWrapping="Wrap" MaxHeight="22"
                                                   Margin="0,0,0,6" Cursor="Hand"
                                                   MouseLeftButtonUp="LyricPrevLine_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk melompat ke baris lirik ini"/>

                                        <TextBlock Grid.Row="1" x:Name="LyricCurrentLineText"
                                                   Text="Putar musik untuk menampilkan lirik tersinkronisasi"
                                                   FontFamily="{StaticResource MacDisplayFont}" FontSize="15" FontWeight="Bold"
                                                   Foreground="#FFFFFFFF" TextWrapping="Wrap" MaxHeight="44"
                                                   Margin="0,2,0,8">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="ActiveLyricShift" Y="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2" x:Name="LyricNext1LineText" Text=""
                                                   Style="{StaticResource NotchBodyText}" FontSize="12" FontWeight="Medium"
                                                   Foreground="#FFAAB4C8" TextWrapping="Wrap" MaxHeight="22"
                                                   Margin="0,0,0,5" Cursor="Hand"
                                                   MouseLeftButtonUp="LyricNext1Line_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk melompat ke baris lirik ini"/>

                                        <TextBlock Grid.Row="3" x:Name="LyricNext2LineText" Text=""
                                                   Style="{StaticResource NotchBodyText}" FontSize="11.5"
                                                   Foreground="#FF6E778C" TextWrapping="Wrap" MaxHeight="20"
                                                   Cursor="Hand"
                                                   MouseLeftButtonUp="LyricNext2Line_MouseLeftButtonUp"
                                                   ToolTip="Klik untuk melompat ke baris lirik ini"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ================================================ -->
                        <!--  VIEW 3: FILE DROP (Drag & Drop File)            -->
                        <!-- ================================================ -->
                        <Border x:Name="ShelfViewGrid" Style="{StaticResource BentoCard}" Padding="14,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="13.5"
                                                   Foreground="#FF64D2FF" Margin="0,0,8,0"/>
                                        <TextBlock Text="File Drop Zone" Style="{StaticResource NotchTitleText}" Foreground="{StaticResource CleanPrimaryText}" FontSize="13"/>
                                        <TextBlock Text="• Seret file masuk atau tarik keluar ke aplikasi lain"
                                                   Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource NotchChipButton}" Height="22" Padding="9,0"
                                                Click="AddFilesPicker_Click" ToolTip="Pilih file dari komputer">
                                            <TextBlock Text="+ Pilih File" Style="{StaticResource NotchCaptionText}"
                                                       Foreground="{StaticResource CleanPrimaryText}" FontWeight="SemiBold"/>
                                        </Button>
                                        <Button Style="{StaticResource NotchChipButton}" Height="22" Padding="9,0" Margin="6,0,0,0"
                                                Click="ClearShelf_Click" ToolTip="Kosongkan semua file">
                                            <TextBlock Text="Bersihkan" Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2">
                                    <Rectangle x:Name="ShelfDropOutline" RadiusX="12" RadiusY="12"
                                               Fill="#FF0B0D13" Stroke="#2EFFFFFF" StrokeThickness="1" StrokeDashArray="4 3"/>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=FileShelfItemsControl}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" FontSize="24"
                                                   Foreground="#FF64D2FF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="Seret &amp; lepas (Drag &amp; Drop) file ke sini"
                                                   Style="{StaticResource NotchBodyText}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource CleanPrimaryText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Tahan lalu tarik kartu file keluar untuk memindahkannya ke folder, browser, atau chat"
                                                   Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  Padding="10,8">
                                        <ItemsControl x:Name="FileShelfItemsControl" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource NotchHoverRow}" Background="#FF181C26"
                                                            BorderBrush="#22FFFFFF" BorderThickness="1"
                                                            CornerRadius="10" Width="118" Height="96" Padding="8" Margin="0,0,8,0"
                                                            ToolTip="{Binding FullPath}"
                                                            MouseMove="ShelfItem_MouseMove">
                                                        <Grid>
                                                            <Button Style="{StaticResource NotchIconButton}" Width="18" Height="18"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                                                    Click="RemoveShelfItem_Click" ToolTip="Hapus">
                                                                <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="8" Foreground="{StaticResource CleanSecondaryText}"/>
                                                            </Button>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Image Width="36" Height="36" Margin="0,2,0,6"
                                                                       Source="{Binding FullPath, Converter={StaticResource ShellIconConverter}, ConverterParameter=96}"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding FileName}" Style="{StaticResource NotchCaptionText}"
                                                                           Foreground="{StaticResource CleanPrimaryText}" FontWeight="SemiBold"
                                                                           MaxWidth="100" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding FileSizeText}" Style="{StaticResource NotchCaptionText}"
                                                                           FontSize="10" Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ================================================ -->
                        <!--  VIEW 4: CLIPBOARD HISTORY AUTO-PASTE            -->
                        <!-- ================================================ -->
                        <Border x:Name="ClipboardViewGrid" Style="{StaticResource BentoCard}" Padding="14,12" Visibility="Collapsed">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77F;" Style="{StaticResource IconGlyph}" FontSize="13"
                                                   Foreground="#FF64D2FF" Margin="0,0,8,0"/>
                                        <TextBlock Text="Clipboard History" Style="{StaticResource NotchTitleText}" Foreground="{StaticResource CleanPrimaryText}" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="Klik item untuk langsung Auto-Paste (Ctrl+V)"
                                               Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <ListBox x:Name="ClipboardListBox"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource CleanListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             FocusVisualStyle="{x:Null}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NotchHoverRow}" Background="#FF171A24"
                                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                                        CornerRadius="8" Padding="10,7" Margin="0,0,0,4"
                                                        ToolTip="{Binding FullText}"
                                                        MouseLeftButtonUp="ClipboardItem_MouseLeftButtonUp">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="Paste ↵"
                                                                   Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                                   Foreground="#FF64D2FF" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding PreviewText}" Style="{StaticResource NotchBodyText}" Foreground="{StaticResource CleanPrimaryText}"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Belum ada teks yang disalin ke Clipboard"
                                               Foreground="{StaticResource CleanSecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource NotchCaptionText}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=ClipboardListBox}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- ================================================ -->
                        <!--  VIEW 5: FOCUS / POMODORO TIMER                  -->
                        <!-- ================================================ -->
                        <Border x:Name="PomodoroViewGrid" Style="{StaticResource BentoCard}" Padding="18,14" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="FOCUS &amp; POMODORO TIMER" Style="{StaticResource NotchCaptionText}"
                                               FontWeight="Bold" Foreground="#FF64D2FF"/>
                                    <TextBlock x:Name="LargePomodoroText" Text="25:00"
                                               FontFamily="{StaticResource MacDisplayFont}" FontSize="44" FontWeight="Bold"
                                               Foreground="{StaticResource CleanPrimaryText}" Margin="0,2,0,4"/>
                                    <TextBlock Text="Gunakan metode 25 menit fokus &amp; 5 menit istirahat untuk produktivitas maksimal."
                                               Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="150">
                                    <Button Style="{StaticResource MacPrimaryButton}" Height="34" Margin="0,0,0,8"
                                            Click="PomodoroButton_Click" Content="Mulai / Jeda"/>
                                    <Button Style="{StaticResource QuickToolButton}" Height="30" Margin="0,0,0,6"
                                            Click="ResetFocus25_Click" Content="Reset Fokus (25:00)"/>
                                    <Button Style="{StaticResource QuickToolButton}" Height="30"
                                            Click="ResetBreak5_Click" Content="Istirahat (05:00)"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ================================================ -->
                        <!--  VIEW 6: CUACA MACOS WEATHER (Ikon 3D + Hourly   -->
                        <!--          Forecast + UV Index Rainbow + Sunset)   -->
                        <!-- ================================================ -->
                        <Border x:Name="WeatherViewGrid" CornerRadius="14" Padding="15,12"
                                BorderBrush="#28FFFFFF" BorderThickness="1" Visibility="Collapsed"
                                Cursor="Hand" MouseLeftButtonUp="OpenWeatherWebsite_MouseLeftButtonUp"
                                ToolTip="Klik untuk membuka prakiraan cuaca lengkap di website">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop x:Name="DetailWeatherGradStart" Color="#FF1D3354" Offset="0"/>
                                    <GradientStop x:Name="DetailWeatherGradEnd" Color="#FF0F1726" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="316"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- KIRI: Header Cuaca macOS + Kartu Kesimpulan & Prakiraan Per Jam (Hourly Forecast) -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Baris Header: Ikon 3D Squircle + Kota + Suhu Besar + Kondisi + H/L -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ds:MacWeatherIcon Grid.Column="0" x:Name="DetailWeatherIconControl"
                                                           Width="46" Height="46"
                                                           ShowSquircleBadge="True"
                                                           IconKind="PartlyCloudy"
                                                           VerticalAlignment="Center"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="DetailWeatherLocText" Text="Lokasi Laptop"
                                                           FontFamily="{StaticResource MacDisplayFont}" FontSize="15" FontWeight="Bold"
                                                           Foreground="#FFFFFFFF"/>
                                                <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="10"
                                                           Foreground="#FF94B4E0" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="DetailWeatherCondText" Text="Partly Cloudy"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="11.5"
                                                       FontWeight="Medium" Foreground="#FFBFD4F2" Margin="0,1,0,0"/>
                                            <TextBlock x:Name="DetailWeatherHighLowText" Text="H:32°  L:24°"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                                       FontWeight="SemiBold" Foreground="#FF94B4E0" Margin="0,1,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailWeatherTempText" Text="30°"
                                                       FontFamily="{StaticResource MacDisplayFont}" FontSize="34" FontWeight="Light"
                                                       Foreground="#FFFFFFFF" LineHeight="34" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource NotchChipButton}" Height="19" Padding="7,0" Margin="0,0,4,0"
                                                        Click="OpenWeatherWebsite_Click" ToolTip="Buka prakiraan lengkap di browser">
                                                    <TextBlock Text="Web ↗" Style="{StaticResource NotchCaptionText}"
                                                               FontSize="9.5" FontWeight="SemiBold" Foreground="#FFF8FAFC"/>
                                                </Button>
                                                <Button Style="{StaticResource NotchIconButton}" Width="20" Height="19"
                                                        Click="RefreshWeather_Click"
                                                        ToolTip="Sinkronkan ulang lokasi &amp; cuaca laptop">
                                                    <TextBlock Text="&#xE72C;" Style="{StaticResource IconGlyph}" FontSize="10" Foreground="#FF94B4E0"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Kartu Kaca macOS: Kesimpulan Cuaca + Prakiraan 6 Jam ke Depan -->
                                    <Border Grid.Row="2" Background="#1CFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="11,7">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="5"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" x:Name="DetailWeatherSummaryText"
                                                       Text="Awan tipis menaungi langit siang ini, sejuk dan nyaman tanpa silau berlebih."
                                                       Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                                       Foreground="#FFE8F0FC" TextTrimming="CharacterEllipsis"/>

                                            <Rectangle Grid.Row="1" Height="1" Fill="#22FFFFFF" VerticalAlignment="Center"/>

                                            <!-- Strip Prakiraan Per Jam (Now, +1h, +2h, +3h, +4h, +5h) -->
                                            <ItemsControl Grid.Row="2" x:Name="HourlyForecastItemsControl" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Rows="1" Columns="6"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeLabel}"
                                                                       Style="{StaticResource NotchCaptionText}" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="#FFD0E0F5"
                                                                       HorizontalAlignment="Center"/>
                                                            <ds:MacWeatherIcon Width="18" Height="18"
                                                                               IconKind="{Binding IconKind}"
                                                                               Margin="0,3,0,3" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding TempCelsius, StringFormat={}{0}°}"
                                                                       Style="{StaticResource NotchBodyText}" FontSize="11"
                                                                       FontWeight="Bold" Foreground="#FFFFFFFF"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- KANAN: Grid 2x2 Widget Cuaca macOS (UV Index Rainbow, Sunset, Wind, Humidity) -->
                                <UniformGrid Grid.Column="2" Rows="2" Columns="2">

                                    <!-- Widget 1: UV INDEX dengan Rainbow Bar khas macOS -->
                                    <Border Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="10,8" Margin="0,0,4,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="☀ UV INDEX" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FF9EB8DC"/>
                                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailUvIndexText" Text="2"
                                                           FontFamily="{StaticResource MacDisplayFont}" FontSize="18" FontWeight="Bold"
                                                           Foreground="#FFFFFFFF" LineHeight="18"/>
                                                <TextBlock x:Name="DetailUvLevelText" Text="Low"
                                                           Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                                           FontWeight="SemiBold" Foreground="#FFD8E6FA"/>
                                            </StackPanel>
                                            <Grid Grid.Row="2" Height="6" VerticalAlignment="Bottom">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FF30D158" Offset="0.0"/>
                                                            <GradientStop Color="#FFFFD60A" Offset="0.3"/>
                                                            <GradientStop Color="#FFFF9F0A" Offset="0.55"/>
                                                            <GradientStop Color="#FFFF375F" Offset="0.8"/>
                                                            <GradientStop Color="#FFBF5AF2" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Ellipse x:Name="UvIndicatorDot" Width="6" Height="6" Fill="#FFFFFFFF"
                                                         Stroke="#FF0F1726" StrokeThickness="1"
                                                         HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Widget 2: SUNSET & SUNRISE -->
                                    <Border Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="10,8" Margin="4,0,0,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="🌅 SUNSET" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FF9EB8DC"/>
                                            <TextBlock Grid.Row="1" x:Name="DetailSunsetText" Text="17:55"
                                                       FontFamily="{StaticResource MacDisplayFont}" FontSize="18" FontWeight="Bold"
                                                       Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" x:Name="DetailSunriseText" Text="Sunrise: 05:50"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="9.5"
                                                       Foreground="#FFBFD4F2"/>
                                        </Grid>
                                    </Border>

                                    <!-- Widget 3: WIND -->
                                    <Border Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="10,8" Margin="0,4,4,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="💨 WIND" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FF9EB8DC"/>
                                            <TextBlock Grid.Row="1" x:Name="DetailWeatherWindText" Text="10 km/h"
                                                       FontFamily="{StaticResource MacDisplayFont}" FontSize="17" FontWeight="Bold"
                                                       Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" x:Name="DetailWeatherFeelsText" Text="Feels like 32°"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="9.5"
                                                       Foreground="#FFBFD4F2"/>
                                        </Grid>
                                    </Border>

                                    <!-- Widget 4: HUMIDITY -->
                                    <Border Background="#1AFFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1"
                                            CornerRadius="12" Padding="10,8" Margin="4,4,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="💧 HUMIDITY" Style="{StaticResource NotchCaptionText}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FF9EB8DC"/>
                                            <TextBlock Grid.Row="1" x:Name="DetailWeatherHumidityText" Text="68%"
                                                       FontFamily="{StaticResource MacDisplayFont}" FontSize="18" FontWeight="Bold"
                                                       Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Text="Synced with laptop"
                                                       Style="{StaticResource NotchCaptionText}" FontSize="9.5"
                                                       Foreground="#FFBFD4F2"/>
                                        </Grid>
                                    </Border>

                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- ================================================ -->
                        <!--  VIEW 7: PUSAT NOTIFIKASI DINAMIS                 -->
                        <!--  (klik item = langsung membuka aplikasi asalnya)  -->
                        <!-- ================================================ -->
                        <Border x:Name="NotificationsViewGrid" Style="{StaticResource BentoCard}" Padding="14,11" Visibility="Collapsed">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}" FontSize="13"
                                                   Foreground="#FF64D2FF" Margin="0,0,8,0"/>
                                        <TextBlock Text="Notifikasi" Style="{StaticResource NotchTitleText}"
                                                   Foreground="{StaticResource CleanPrimaryText}" FontSize="13"/>
                                        <Border x:Name="NotificationCountChip" Background="#1FFFFFFF" CornerRadius="7"
                                                Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="NotificationCountText" Text="0" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource CleanPrimaryText}"/>
                                        </Border>
                                        <TextBlock x:Name="NotificationStatusText" Text="Menghubungkan ke notifikasi Windows..."
                                                   Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                                   Foreground="{StaticResource CleanSecondaryText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="250"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="GrantNotificationAccessButton" Style="{StaticResource NotchChipButton}"
                                                Height="22" Padding="9,0" Margin="0,0,6,0" Visibility="Collapsed"
                                                Click="GrantNotificationAccess_Click"
                                                ToolTip="Izinkan Sky Bar membaca notifikasi Windows">
                                            <TextBlock Text="Izinkan Akses" Style="{StaticResource NotchCaptionText}"
                                                       Foreground="#FF64D2FF" FontWeight="SemiBold"/>
                                        </Button>
                                        <Button Style="{StaticResource NotchChipButton}" Height="22" Padding="9,0"
                                                Click="ClearNotifications_Click" ToolTip="Hapus semua notifikasi">
                                            <TextBlock Text="Bersihkan" Style="{StaticResource NotchCaptionText}"
                                                       Foreground="{StaticResource CleanPrimaryText}" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <ListBox x:Name="NotificationsListBox"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             ItemContainerStyle="{StaticResource CleanListBoxItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="False"
                                             FocusVisualStyle="{x:Null}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource NotchHoverRow}" Background="#FF171A24"
                                                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                                                        CornerRadius="11" Padding="9,7" Margin="0,0,0,5"
                                                        ToolTip="Klik untuk membuka aplikasi asal"
                                                        MouseLeftButtonUp="NotificationItem_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="10"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Ikon aplikasi asal (logo atau glyph berwarna) -->
                                                        <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                                            <Border CornerRadius="9" Background="{Binding AccentBrush}">
                                                                <TextBlock Text="{Binding GlyphText}" FontFamily="{Binding GlyphFont}"
                                                                           FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border CornerRadius="9" Background="#FF1F2330">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding AppName}" Style="{StaticResource NotchCaptionText}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource CleanSecondaryText}" MaxWidth="200"/>
                                                                <TextBlock Text=" • " FontSize="10" Foreground="{StaticResource CleanMutedText}"/>
                                                                <TextBlock Text="{Binding TimeAgoText}" Style="{StaticResource NotchCaptionText}"
                                                                           FontSize="10" Foreground="{StaticResource CleanMutedText}"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Title}" Style="{StaticResource NotchBodyText}"
                                                                       FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource CleanPrimaryText}" Margin="0,1,0,0"/>
                                                            <TextBlock Text="{Binding BodyOrPlaceholder}" Style="{StaticResource NotchCaptionText}"
                                                                       FontSize="11" Foreground="{StaticResource CleanSecondaryText}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource IconGlyph}" FontSize="10"
                                                                       Foreground="{StaticResource CleanMutedText}" Margin="0,0,4,0"/>
                                                            <Button Style="{StaticResource NotchIconButton}" Width="22" Height="22"
                                                                    Click="DismissNotification_Click" ToolTip="Tutup notifikasi">
                                                                <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="8.5"
                                                                           Foreground="{StaticResource CleanSecondaryText}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasItems, ElementName=NotificationsListBox}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="&#xEA8F;" Style="{StaticResource IconGlyph}" FontSize="22"
                                                   Foreground="{StaticResource CleanMutedText}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Semua sudah terbaca" Style="{StaticResource NotchBodyText}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource CleanPrimaryText}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="Notifikasi baru akan muncul secara dinamis di Notch"
                                                   Style="{StaticResource NotchCaptionText}" Foreground="{StaticResource CleanSecondaryText}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!--  STATE 3: BANNER NOTIFIKASI DINAMIS (ala Dynamic Island)  -->
                <!-- ======================================================== -->
                <Grid x:Name="NotificationBannerGrid"
                      Width="364" Height="58" Margin="0,8,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BannerScale" ScaleX="0.9" ScaleY="0.9"/>
                            <TranslateTransform x:Name="BannerShift" Y="-8"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Border x:Name="NotificationBannerSurface" Background="Transparent" Cursor="Hand"
                            ToolTip="Klik untuk membuka aplikasi asal"
                            MouseLeftButtonUp="NotificationBanner_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="11"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                <Border x:Name="BannerGlyphHost" CornerRadius="11" Background="#FF0A84FF">
                                    <TextBlock x:Name="BannerGlyphText" Text="&#xEA8F;" FontSize="17" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MacIconFont}" Foreground="#FFFFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border x:Name="BannerIconHost" CornerRadius="11" Background="#FF1F2330" Visibility="Collapsed">
                                    <Image x:Name="BannerIconImage" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="BannerAppNameText" Text="Sky Bar" Style="{StaticResource NotchCaptionText}"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CleanSecondaryText}" MaxWidth="180"/>
                                    <TextBlock Text=" • sekarang" Style="{StaticResource NotchCaptionText}" FontSize="10.5"
                                               Foreground="{StaticResource CleanMutedText}"/>
                                </StackPanel>
                                <TextBlock x:Name="BannerTitleText" Text="Notifikasi" Style="{StaticResource NotchBodyText}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CleanPrimaryText}" Margin="0,1,0,0"/>
                                <TextBlock x:Name="BannerBodyText" Text="" Style="{StaticResource NotchCaptionText}"
                                           FontSize="11" Foreground="{StaticResource CleanSecondaryText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Height="24"
                                        Click="BannerShowAll_Click" ToolTip="Lihat semua notifikasi">
                                    <TextBlock Text="&#xE70D;" Style="{StaticResource IconGlyph}" FontSize="10"
                                               Foreground="{StaticResource CleanSecondaryText}"/>
                                </Button>
                                <Button Style="{StaticResource NotchIconButton}" Width="24" Height="24"
                                        Click="BannerDismiss_Click" ToolTip="Tutup">
                                    <TextBlock Text="&#xE8BB;" Style="{StaticResource IconGlyph}" FontSize="9"
                                               Foreground="{StaticResource CleanSecondaryText}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
