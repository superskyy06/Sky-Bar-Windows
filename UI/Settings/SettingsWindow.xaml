<Window x:Class="SkyBar.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sky Bar — Pengaturan"
        Width="740" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource MacPrimaryFont}">

    <Window.Resources>
        <SolidColorBrush x:Key="NdWindowBg" Color="#FF0F1015"/>
        <SolidColorBrush x:Key="NdHeaderBg" Color="#FF14151C"/>
        <SolidColorBrush x:Key="NdCardBg" Color="#FF181A22"/>
        <SolidColorBrush x:Key="NdCardBorder" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="NdRowDivider" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="NdIconBadgeBg" Color="#FF222530"/>
        <SolidColorBrush x:Key="NdControlWellBg" Color="#FF101117"/>
        <SolidColorBrush x:Key="NdSegmentActiveBg" Color="#FF323646"/>
        <SolidColorBrush x:Key="NdTextPrimary" Color="#FFF5F7FA"/>
        <SolidColorBrush x:Key="NdTextSecondary" Color="#FF8E95A5"/>

        <!-- Pill Tab Atas Modern -->
        <Style x:Key="TopTabRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="14,7">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource MacIconFont}" FontSize="12.5"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NdSegmentActiveBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Pill RadioButton (Notch | Pill | Bar, 12-hour | 24-hour) -->
        <Style x:Key="SnSegmentItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="14,6" Margin="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacAccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kotak ikon kiri pada setiap baris pengaturan -->
        <Style x:Key="SnIconBadge" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource NdIconBadgeBg}"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- Switch kompak -->
        <Style x:Key="SnCompactSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="24" Background="Transparent">
                            <Border CornerRadius="12" Background="#FF2E3240"/>
                            <Border x:Name="OnTrack" CornerRadius="12" Background="{DynamicResource MacAccentBrush}" Opacity="0"/>
                            <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider Modern -->
        <Style x:Key="SnSliderFillRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3,0,0,3" Background="{DynamicResource MacAccentBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnSliderEmptyRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="0,3,3,0" Background="#FF2B2F3C"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="#FFFFFFFF" Stroke="{DynamicResource MacAccentBrush}" StrokeThickness="3">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Opacity="0.4"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SnSliderFillRepeat}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SnSliderEmptyRepeat}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SnSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Pill -->
        <Style x:Key="SnPillComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,7" Margin="2,1" Background="Transparent"
                                TextElement.Foreground="{StaticResource NdTextPrimary}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacAccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnPillComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SnPillComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{StaticResource NdTextPrimary}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource NdControlWellBg}"
                                                BorderBrush="#1FFFFFFF" BorderThickness="1"
                                                CornerRadius="9" Padding="12,7"
                                                TextElement.Foreground="{StaticResource NdTextPrimary}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Text, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           FontFamily="{StaticResource MacPrimaryFont}"
                                                           FontSize="12.5" FontWeight="Medium"
                                                           Foreground="{StaticResource NdTextPrimary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource MacIconFont}"
                                                           FontSize="10" Foreground="{StaticResource NdTextSecondary}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#36FFFFFF"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#FF161822"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240" Margin="0,4,0,0">
                                    <Border Background="#FF1C1F2B" BorderBrush="#2AFFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45"/>
                                        </Border.Effect>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol kontrol jendela kanan atas -->
        <Style x:Key="SnWindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource NdTextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource NdTextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Bingkai utama jendela -->
    <Border CornerRadius="18"
            Background="{StaticResource NdWindowBg}"
            BorderBrush="#26FFFFFF"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!--  HEADER BAR ATAS MODERN (Brand + Pill Tabs + Kontrol)    -->
            <!-- ======================================================== -->
            <Border Grid.Row="0" Background="{StaticResource NdHeaderBg}" Padding="24,0,18,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <!-- Brand Kiri -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border Width="36" Height="22" CornerRadius="11" Background="#FF07080C"
                                BorderBrush="{DynamicResource MacAccentBrush}" BorderThickness="1.4"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                            <Grid Margin="5,0">
                                <Ellipse Width="5" Height="5" Fill="{DynamicResource MacAccentBrush}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="1.5" Height="6" Fill="#FF7EB6FF" Margin="0.8,0" RadiusX="0.7" RadiusY="0.7"/>
                                    <Rectangle Width="1.5" Height="9" Fill="{DynamicResource MacAccentBrush}" Margin="0.8,0" RadiusX="0.7" RadiusY="0.7"/>
                                    <Rectangle Width="1.5" Height="5" Fill="#FF7EB6FF" Margin="0.8,0" RadiusX="0.7" RadiusY="0.7"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sky Bar" Foreground="{StaticResource NdTextPrimary}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="#1F0A84FF" BorderBrush="#440A84FF" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v1.0.0" Foreground="#FF64B5F6" FontSize="9.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Settings" Foreground="{StaticResource NdTextSecondary}" FontSize="10.5"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigasi Tab Tengah -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource NdControlWellBg}"
                            BorderBrush="#16FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="4,3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NavGeneralRadio" Content="Tampilan &amp; Notch" Tag="&#xE7F4;"
                                         Style="{StaticResource TopTabRadio}" IsChecked="True"
                                         Checked="SidebarNav_Checked"/>
                            <RadioButton x:Name="NavAppearanceRadio" Content="Tema &amp; Warna" Tag="&#xE790;"
                                         Style="{StaticResource TopTabRadio}"
                                         Checked="SidebarNav_Checked"/>
                            <RadioButton x:Name="NavWidgetsRadio" Content="Sistem" Tag="&#xE713;"
                                         Style="{StaticResource TopTabRadio}"
                                         Checked="SidebarNav_Checked"/>
                        </StackPanel>
                    </Border>

                    <!-- Tombol Reset, Minimize & Close Kanan -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource SnWindowChromeButton}" Width="Auto" Padding="10,0" Margin="0,0,6,0"
                                Click="ResetDefaults_Click" ToolTip="Kembalikan ke pengaturan awal">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource MacIconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Reset" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SnWindowChromeButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource MacIconFont}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource SnWindowChromeButton}" Click="CloseButton_Click" ToolTip="Tutup" Margin="2,0,0,0">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource MacIconFont}" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Rectangle Grid.Row="1" Fill="#16FFFFFF"/>

            <!-- ======================================================== -->
            <!--  AREA KONTEN UTAMA                                       -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,22,28,26">
                <Grid>

                    <!-- ==================================================== -->
                    <!--  TAB 1: TAMPILAN & NOTCH                             -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="PageGeneral" Visibility="Visible">

                        <!-- 2 Kartu Bento di Atas: Bentuk Notch & Format Jam -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kartu Gaya Notch -->
                            <Border Grid.Column="0" Background="{StaticResource NdCardBg}"
                                    BorderBrush="{StaticResource NdCardBorder}" BorderThickness="1"
                                    CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource SnIconBadge}" Width="30" Height="30" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource MacAccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Bentuk Notch" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Notch tepi atas, kapsul melayang, atau bar." Foreground="{StaticResource NdTextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource NdControlWellBg}" BorderBrush="#14FFFFFF"
                                            BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="StyleNotchRadio" Content="Notch" GroupName="NotchStyleGroup"
                                                         Style="{StaticResource SnSegmentItem}" Checked="NotchStyle_Checked"/>
                                            <RadioButton x:Name="StylePillRadio" Content="Pill" GroupName="NotchStyleGroup"
                                                         Style="{StaticResource SnSegmentItem}" Checked="NotchStyle_Checked"/>
                                            <RadioButton x:Name="StyleBarRadio" Content="Bar" GroupName="NotchStyleGroup"
                                                         Style="{StaticResource SnSegmentItem}" Checked="NotchStyle_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Kartu Format Jam -->
                            <Border Grid.Column="2" Background="{StaticResource NdCardBg}"
                                    BorderBrush="{StaticResource NdCardBorder}" BorderThickness="1"
                                    CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Style="{StaticResource SnIconBadge}" Width="30" Height="30" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE823;" Style="{StaticResource IconGlyph}" FontSize="13" Foreground="{DynamicResource MacAccentBrush}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Format Waktu" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="Tampilan jam saat notch tertutup." Foreground="{StaticResource NdTextSecondary}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Background="{StaticResource NdControlWellBg}" BorderBrush="#14FFFFFF"
                                            BorderThickness="1" CornerRadius="9" Padding="3" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="Clock12Radio" Content="12-hour" GroupName="ClockFormatGroup"
                                                         Style="{StaticResource SnSegmentItem}" Checked="ClockFormat_Checked"/>
                                            <RadioButton x:Name="Clock24Radio" Content="24-hour" GroupName="ClockFormatGroup"
                                                         Style="{StaticResource SnSegmentItem}" Checked="ClockFormat_Checked"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Kartu Ukuran, Jarak & Monitor -->
                        <Border Background="{StaticResource NdCardBg}"
                                BorderBrush="{StaticResource NdCardBorder}"
                                BorderThickness="1" CornerRadius="14" Margin="0,0,0,16">
                            <StackPanel>

                                <!-- Jarak dari Tepi Layar -->
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE740;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Jarak dari tepi atas layar" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Atur seberapa dekat kapsul/notch dengan batas atas monitor."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="EdgeDistanceSlider" Width="175"
                                                Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{StaticResource SnSlider}"
                                                ValueChanged="EdgeDistanceSlider_ValueChanged"/>
                                        <TextBlock x:Name="EdgeDistanceValueText" Text="0px"
                                                   Foreground="{StaticResource NdTextPrimary}" FontWeight="SemiBold" FontSize="12.5"
                                                   Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Ukuran Skala -->
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE740;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Ukuran Notch / Pill" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Sesuaikan skala proporsi notch dengan resolusi layar laptop."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider x:Name="ScaleSlider" Width="175"
                                                Minimum="65" Maximum="130" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Style="{StaticResource SnSlider}"
                                                ValueChanged="ScaleSlider_ValueChanged"/>
                                        <TextBlock x:Name="ScaleValueText" Text="100%"
                                                   Foreground="{StaticResource NdTextPrimary}" FontWeight="SemiBold" FontSize="12.5"
                                                   Width="44" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Pilihan Monitor -->
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Tampilkan pada layar" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Pilih monitor tempat Notch ditampilkan."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="MonitorComboBox"
                                              Style="{StaticResource SnPillComboBox}" MinWidth="160" VerticalAlignment="Center"
                                              SelectionChanged="MonitorComboBox_SelectionChanged"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Kartu Saat Notch Tertutup -->
                        <Border Background="{StaticResource NdCardBg}"
                                BorderBrush="{StaticResource NdCardBorder}"
                                BorderThickness="1" CornerRadius="14">
                            <StackPanel>

                                <!-- Indikator Kiri Saat Tertutup -->
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Indikator sisi kiri (saat tertutup)" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Pilih informasi yang tampil di kiri saat notch sedang tertutup."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="ClosedLeftComboBox"
                                              Style="{StaticResource SnPillComboBox}" MinWidth="150" VerticalAlignment="Center"
                                              SelectionChanged="ClosedLeftComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="Auto" Content="✨ Otomatis (Media)"/>
                                        <ComboBoxItem Tag="Weather" Content="⛅ Cuaca Lokal"/>
                                        <ComboBoxItem Tag="Pomodoro" Content="⏱ Timer Fokus"/>
                                        <ComboBoxItem Tag="Nothing" Content="○ Sembunyikan"/>
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Music Visualizer -->
                                <Grid Margin="18,13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE767;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Visualizer musik aktif" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Tampilkan animasi gelombang equalizer di kanan saat musik diputar."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="MusicVisualizerCheck"
                                              Style="{StaticResource SnCompactSwitch}"
                                              Click="ToggleSetting_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!--  TAB 2: TEMA & WARNA                                 -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <Border Background="{StaticResource NdCardBg}"
                                BorderBrush="{StaticResource NdCardBorder}"
                                BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <!-- Theme Mode -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE790;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Tema Aplikasi" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ikuti tema sistem Windows, Gelap, atau Terang."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" x:Name="ThemeComboBox"
                                              Style="{StaticResource SnPillComboBox}" MinWidth="148" VerticalAlignment="Center"
                                              SelectionChanged="ThemeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="Otomatis (Sistem)" Tag="Auto"/>
                                        <ComboBoxItem Content="Mode Gelap" Tag="Dark"/>
                                        <ComboBoxItem Content="Mode Terang" Tag="Light"/>
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Accent Color -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE734;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Warna Aksen" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Warna sorotan untuk indikator aktif, slider, dan equalizer."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Tag="#0A84FF" Width="24" Height="24" Margin="4,0" Cursor="Hand" Click="AccentColor_Click" ToolTip="macOS Blue">
                                            <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#0A84FF" Stroke="#55FFFFFF" StrokeThickness="1.5"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Tag="#BF5AF2" Width="24" Height="24" Margin="4,0" Cursor="Hand" Click="AccentColor_Click" ToolTip="Purple">
                                            <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#BF5AF2" Stroke="#55FFFFFF" StrokeThickness="1.5"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Tag="#FF375F" Width="24" Height="24" Margin="4,0" Cursor="Hand" Click="AccentColor_Click" ToolTip="Rose Pink">
                                            <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#FF375F" Stroke="#55FFFFFF" StrokeThickness="1.5"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Tag="#FF9F0A" Width="24" Height="24" Margin="4,0" Cursor="Hand" Click="AccentColor_Click" ToolTip="Amber Orange">
                                            <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#FF9F0A" Stroke="#55FFFFFF" StrokeThickness="1.5"/></ControlTemplate></Button.Template>
                                        </Button>
                                        <Button Tag="#30D158" Width="24" Height="24" Margin="4,0" Cursor="Hand" Click="AccentColor_Click" ToolTip="Mint Green">
                                            <Button.Template><ControlTemplate TargetType="Button"><Ellipse Fill="#30D158" Stroke="#55FFFFFF" StrokeThickness="1.5"/></ControlTemplate></Button.Template>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Spring Animations -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE945;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Animasi Pegas Halus (macOS Spring)" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Efek transisi pegas mulus saat Notch membuka dan menutup."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="EnableAnimationsCheck"
                                              Style="{StaticResource SnCompactSwitch}"
                                              Click="ToggleSetting_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================================================== -->
                    <!--  TAB 3: SISTEM                                       -->
                    <!-- ==================================================== -->
                    <StackPanel x:Name="PageWidgets" Visibility="Collapsed">
                        <Border Background="{StaticResource NdCardBg}"
                                BorderBrush="{StaticResource NdCardBorder}"
                                BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <!-- Show Notch -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Tampilkan Notch di Layar" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Aktifkan panel interaktif Notch di bagian atas layar."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="ShowNotchCheck"
                                              Style="{StaticResource SnCompactSwitch}"
                                              Click="ToggleSetting_Click"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Auto-hide in Fullscreen Games -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE7FC;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Sembunyikan saat bermain Game Fullscreen" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Otomatis menyembunyikan Notch saat aplikasi/game layar penuh berjalan."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="AutoHideGameCheck"
                                              Style="{StaticResource SnCompactSwitch}"
                                              Click="ToggleSetting_Click"/>
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource NdRowDivider}"/>

                                <!-- Launch at Startup -->
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                        <TextBlock Text="&#xE7E8;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource NdTextSecondary}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Jalankan otomatis saat Windows menyala" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Mulai Sky Bar secara otomatis setiap kali masuk ke Windows."
                                                   Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" x:Name="StartWithWindowsCheck"
                                              Style="{StaticResource SnCompactSwitch}"
                                              Click="ToggleSetting_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Kartu Informasi Versi Aplikasi -->
                        <Border Background="{StaticResource NdCardBg}"
                                BorderBrush="{StaticResource NdCardBorder}"
                                BorderThickness="1" CornerRadius="14" Margin="0,14,0,0">
                            <Grid Margin="18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SnIconBadge}">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconGlyph}" Foreground="{DynamicResource MacAccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Sky Bar for Windows" Foreground="{StaticResource NdTextPrimary}" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Version 1.0.0 • Official Release"
                                               Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Background="#1A30D158" BorderBrush="#4030D158" BorderThickness="1"
                                        CornerRadius="99" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="#FF30D158" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Up to date" Foreground="#FF30D158" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <!-- ======================================================== -->
            <!--  FOOTER STATUS VERSI APLIKASI                            -->
            <!-- ======================================================== -->
            <Rectangle Grid.Row="3" Fill="#14FFFFFF"/>
            <Border Grid.Row="4" Background="{StaticResource NdHeaderBg}" Padding="24,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="Sky Bar" Foreground="{StaticResource NdTextPrimary}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="  •  Version 1.0.0" Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#FF30D158" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Up to date" Foreground="{StaticResource NdTextSecondary}" FontSize="11.5" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
